<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Amendment A-6: the only permission SHIELDRA requests. It exists because a
      local event notification cannot be shown on Android 13+ without it, and it
      is requested from the notification setup screen (with the reason shown
      first) — never from the Panic press. A refusal never blocks recording a
      Security Event. No other permission is declared: no camera, no location,
      no phone state, and no network permission.

      Amendment A-19 (with the service that needs them, never ahead of it): the
      two foreground-service permissions belong to
      com.shieldra.detection.MotionMonitoringService and to nothing else.
      A-17 approved `specialUse` as the type after the four candidate types were
      reviewed one by one, and A-18/Q-G5-b keeps monitoring from starting at all
      when the ongoing notification would not be visible. Still no camera, no
      location, no phone state, no network permission, and no boot permission
      (A-10 — monitoring is started by the user, never by the device waking up).

      Amendment A-32 (owner, 2026-10-03): alerts leave the phone through the owner's own Telegram
      bot and email account, so INTERNET is declared for that one purpose, and ACCESS_NETWORK_STATE
      so an alert kept while offline is sent the moment a network is usable again. Both are
      install-time permissions: no dialog, nothing shown to whoever holds the phone.

      Amendment A-33/A-34 (owner, 2026-10-13): the protection guards. Each permission is granted by
      the owner on first use and exists for one job:
        CAMERA — the front-camera evidence photo on a confirmed event.
        ACCESS_FINE_LOCATION / ACCESS_COARSE_LOCATION — the position fix on a confirmed event.
        FOREGROUND_SERVICE_CAMERA / FOREGROUND_SERVICE_LOCATION — the owner-started protection
          service's declared types, so camera and location keep working in the background.
        RECEIVE_BOOT_COMPLETED — resume the guards the owner had on after a reboot (A-10 relaxed).
        WAKE_LOCK — hold the CPU awake for the seconds a capture and send take.
        READ_PHONE_STATE — read which SIM is present, to tell a swap from the owner's own SIM.
        REQUEST_IGNORE_BATTERY_OPTIMIZATIONS — ask the owner to exempt the app so a thief's phone
          cannot doze the guards; a theft can happen at any hour.
        SCHEDULE_EXACT_ALARM — fire the owner's periodic countdown on time. USE_EXACT_ALARM is
          deliberately not declared: Google Play reserves it for alarm-clock and calendar apps,
          and every scheduling call already degrades to an inexact alarm until the owner grants
          exact scheduling in system settings (F-PLAY-1).
        VIBRATE — A-46: the snatch's ten-minute proof window is felt as a repeating vibration, and
          every escalating send pulses. Install-time, no dialog.   [A-46 amendment, owner 2026-11-10]
      Nothing is shown to whoever holds the phone; every capture is silent.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- A-46 (owner decision 2026-11-10): the snatch proof window and its escalation pulses. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:name=".ShieldraApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Shieldra">
        <!-- `locale` and `layoutDirection` are deliberately NOT in configChanges: when the owner
             switches the phone's language, this activity must be rebuilt so attachBaseContext can
             pick the new one. The in-process app-lock session survives the recreate. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Motion monitoring (slice G5). Not exported: only the app's own runtime
          handle starts it, only from a user action on the dashboard. It holds the
          single MotionSensorAdapter, so no other component may bind to it or
          start it for a second registration.
        -->
        <service
            android:name="com.shieldra.detection.MotionMonitoringService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Continuous accelerometer sampling for the SHIELDRA Motion guard, started only by the device owner from the dashboard" />
        </service>

        <!--
          A-34: the protection service that holds the camera and location capability for the guards.
          Not exported: only the app's own code and its own receivers start it, and only after the
          owner armed protection from the dashboard. Types camera|location so the capability it was
          started with survives into the background.
        -->
        <service
            android:name="com.shieldra.protection.ProtectionService"
            android:exported="false"
            android:foregroundServiceType="camera|location|microphone" />

        <!--
          A-33 Lock guard (restored 2026-11-07 by owner order) + A-46 (owner decision 2026-11-10):
          the one device-admin receiver. Its XML declares `<watch-login />` and `<force-lock />`, and
          those two are the whole grant: the platform reports wrong unlock attempts, and a confirmed
          snatch may close the screen. Wipe, password reset and keyguard change stay unavailable, and
          DeviceScreenLock is the only caller of lockNow(). Exported because the system is the sender;
          BIND_DEVICE_ADMIN is required, so no other app can drive it. The owner grants the role from
          Settings and can revoke it at any time.
        -->
        <receiver
            android:name="com.shieldra.protection.LockGuardReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!--
          A-33 (A-10 relaxed) + audit E-2: resume the guards the owner had on after a reboot. Exported
          so the system can deliver the boot broadcasts; it starts nothing unless the stored armed flag
          is set. Direct-boot aware because that is the only way LOCKED_BOOT_COMPLETED is delivered at
          all, and the only thing it reads before the first unlock is the armed flag in device-protected
          storage — no secret, no evidence, no delivery coordinate crosses that line.
        -->
        <receiver
            android:name="com.shieldra.protection.BootReceiver"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
          A-46: the snatch ladder's tick. Not exported: it only receives the alarm SHIELDRA itself
          scheduled. Direct-boot aware, like the boot receiver, so a phone restarted with a snatch
          open can be reached at its lock screen; the alarm carries no evidence and no owner text.
        -->
        <receiver
            android:name="com.shieldra.protection.SnatchReceiver"
            android:directBootAware="true"
            android:exported="false" />

        <!--
          A-33: the countdown's alarm and snooze receiver. Not exported: it only receives the exact
          alarms and the snooze action SHIELDRA itself scheduled.
        -->
        <receiver
            android:name="com.shieldra.protection.CountdownReceiver"
            android:exported="false" />

        <!--
          A-33 capture path: retries the captures that were queued when a background trigger could not
          start the service. Not exported: it only receives the one short alarm SHIELDRA itself scheduled.
        -->
        <receiver
            android:name="com.shieldra.protection.PendingCaptureReceiver"
            android:exported="false" />

        <!--
          Audit development أ: the guard heartbeat patrol. Not exported: it only receives the one alarm
          SHIELDRA itself scheduled. It lives outside the protection service on purpose — the failure it
          measures is that service dying, so it cannot be the one asking whether it is still alive.
        -->
        <receiver
            android:name="com.shieldra.protection.GuardWatchdogReceiver"
            android:exported="false" />

        <!--
          A-45 D2: the safe-zone tick. Not exported: it only receives the one alarm SHIELDRA itself
          scheduled. It sits outside the protection service for the same reason the patrol does — the
          service is what the OEM kills first, and the Motion ladder reads the zone state to decide
          whether to make a noise, so that state has to keep being refreshed with no service alive.
        -->
        <receiver
            android:name="com.shieldra.protection.GeofenceTickReceiver"
            android:exported="false" />
    </application>
</manifest>
