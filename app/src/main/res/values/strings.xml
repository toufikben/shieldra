    <string name="alert_email_help_title">How to get an app password</string>
    <string name="alert_email_help_body">An app password is not your normal password. Gmail: turn on 2-Step Verification, then open myaccount.google.com/apppasswords, create one for \"Mail\", and paste the 16 letters here. Outlook and Yahoo have the same option in their account security settings. The server fields fill in automatically for Gmail, Outlook, Yahoo and iCloud.</string>
