<?xml version="1.0" encoding="utf-8"?>
<!--
  A-45 D3: the locked-phone notice is written for whoever is holding the phone, not for the owner's
  own UI (which stays Arabic and English). So this file carries only the holder-facing copy. Other
  strings fall back to values/strings.xml. Apostrophes are avoided on purpose: AAPT2 requires ASCII
  ones to be escaped, and the copy reads the same without them.

  The settings copy that explains the notice (protection_notice_title, protection_owner_contact_hint,
  protection_owner_contact_error, protection_theft_notice_note) is deliberately NOT translated here: it
  is owner-facing UI, and the owner's UI is Arabic and English. A phone set to French reads those lines
  in English, exactly like every other line of this app. The notice itself is the exception because it
  is read by a stranger, and TheftDemand composes all three languages by hand rather than trusting the
  device locale.
-->
<resources>
    <string name="theft_demand_channel">Avis de téléphone verrouillé</string>
    <string name="theft_demand_title">Ce téléphone a été verrouillé après un mouvement confirmé</string>
    <string name="theft_demand_body">Si vous êtes le propriétaire, déverrouillez le téléphone pour arrêter les alertes. Sinon, le téléphone envoie sa position et ses photos à son propriétaire, en continu.</string>
    <string name="theft_demand_owner_message">Note du propriétaire : %1$s</string>
    <string name="theft_demand_contact">Contact du propriétaire : %1$s</string>
    <string name="theft_demand_call">Appeler le propriétaire</string>
</resources>
